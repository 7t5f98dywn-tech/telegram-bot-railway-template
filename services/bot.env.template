# ── Service: bot ─────────────────────────────────────────────────────────────
# Source: GitHub repo (this repository, root directory: /app if you keep the
# monorepo layout, or / if you publish app/ as its own repo).
# Public networking: REQUIRED (Telegram must reach the webhook over HTTPS).
# Paste these into Railway's template composer variables for the "bot" service.

# REQUIRED — user supplied. Get it from @BotFather in Telegram:
#   1. Open https://t.me/BotFather  2. Send /newbot  3. Copy the token.
# Format looks like: 123456789:AAH8x...
TELEGRAM_BOT_TOKEN=

# Auto-generated per deploy by Railway. Telegram echoes this back in the
# X-Telegram-Bot-Api-Secret-Token header; the bot rejects any request
# without it (allowed chars: A-Z a-z 0-9 _ -).
WEBHOOK_SECRET=${{ secret(32) }}

# OPTIONAL — cross-service reference to the Postgres service over the
# private network (IPv6-only, no egress fees). Delete this line if you
# remove the Postgres service; the bot falls back to in-memory storage.
DATABASE_URL=${{ Postgres.DATABASE_URL }}

# OPTIONAL overrides (defaults shown)
LOG_LEVEL=INFO
WEBHOOK_PATH=/telegram/webhook
DROP_PENDING_UPDATES=false

# Injected automatically by Railway — do NOT set these yourself:
#   PORT                   -> the port the aiohttp server binds to (0.0.0.0)
#   RAILWAY_PUBLIC_DOMAIN  -> used to auto-register the webhook on startup
