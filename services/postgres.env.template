# ── Service: Postgres (OPTIONAL) ─────────────────────────────────────────────
# Image: ghcr.io/railwayapp-templates/postgres-ssl:17
# Networking: PRIVATE ONLY — do not add a public domain or TCP proxy unless
# you need external access.
# Volume: mount a volume at /var/lib/postgresql/data (persists data).
#
# To remove this service from the template entirely: delete it in the
# composer and remove the DATABASE_URL line from the bot service. The bot
# detects the missing DATABASE_URL and runs with in-memory storage.

PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{ secret(32) }}
POSTGRES_DB=railway
SSL_CERT_DAYS=820

# Connection string the bot consumes via ${{ Postgres.DATABASE_URL }}.
# RAILWAY_PRIVATE_DOMAIN resolves over the IPv6 private network.
DATABASE_URL=postgresql://${{ POSTGRES_USER }}:${{ POSTGRES_PASSWORD }}@${{ RAILWAY_PRIVATE_DOMAIN }}:5432/${{ POSTGRES_DB }}
